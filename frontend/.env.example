# ==============================================================================
# ShelfShare Frontend Environment Variables Configuration
# Copy this file to .env for local development or configure in Vercel Frontend Project Settings.
# ==============================================================================

# Backend REST API Base URL
# Local Development: http://localhost:5000/api
# Production on Vercel: Set to your deployed backend URL ending with /api
# (e.g. https://your-backend-project.vercel.app/api)
VITE_API_BASE_URL=http://localhost:5000/api
