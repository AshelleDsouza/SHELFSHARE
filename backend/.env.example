# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shelfshare_db

# Security & Authentication
JWT_SECRET=shelfshare_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=shelfshare_cookie_secret_key_change_me

# Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
