# ==============================================================================
# ShelfShare Backend Environment Variables Configuration
# Copy this file to .env for local development or configure these in Vercel Project Settings.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development # Set to 'production' on Vercel

# Allowed Frontend URL(s) for CORS
# In production on Vercel: set to your deployed frontend domain (e.g. https://your-frontend.vercel.app)
# Multiple origins can be separated by commas (e.g. https://shelfshare.vercel.app,http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Hosted MySQL Database Configuration
# You can provide either a single DATABASE_URL / MYSQL_URL, OR the individual DB_* variables.
# ------------------------------------------------------------------------------
# Option A: Individual Variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shelfshare_db
DB_SSL=false # Set to 'true' for hosted cloud MySQL providers (Aiven, TiDB, PlanetScale, AWS RDS)

# Option B: Complete Connection URI (Common on Railway, Supabase/RDS, PlanetScale)
# DATABASE_URL=mysql://username:password@hostname:3306/shelfshare_db

# ------------------------------------------------------------------------------
# JWT Authentication & Cookie Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_encryption_secret_random_string

# ------------------------------------------------------------------------------
# Persistent Cloud File Storage (Cloudinary)
# Required for Vercel deployment where the local server filesystem is ephemeral.
# Sign up free at https://cloudinary.com to get these three credentials.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Automatic Database Table Verification on Startup (Default: true)
AUTO_INIT_DB=true
